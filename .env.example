PORT=3000
PG_HOST=localhost
PG_PORT=5432
PG_USER=postgres
PG_PASSWORD=postgres
PG_DATABASE=cars

# S3 photo storage (placeholders — replace with real values in your local .env)
S3_BUCKET=your-bucket-name
AWS_ACCESS_KEY_ID=your-access-key-id
AWS_SECRET_ACCESS_KEY=your-secret-access-key
AWS_REGION=us-east-1

# API key auth (shared secret). Required for POST/DELETE /cars and photo endpoints.
# Clients send it as: Authorization: Bearer <API_KEY>  (or X-API-Key: <API_KEY>)
API_KEY=your-api-key

